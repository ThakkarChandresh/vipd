[Unit]
Description=vipd virtual IP failover
Documentation=https://github.com/ThakkarChandresh/vipd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vipd run --config /etc/vipd/vipd.toml
Restart=on-failure
RestartSec=2
# An invalid config (exit code 2) does not fix itself.
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
